{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./packages/core-components/src/styles.css",
    "functions": ["cn"]
  },
  "ignorePatterns": ["dist", "storybook-static", "pnpm-lock.yaml"]
}
