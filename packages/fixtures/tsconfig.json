{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Runs directly on Node's type stripping, like the capture package.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
