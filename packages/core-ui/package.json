{
  "name": "@snapcheck/core-ui",
  "version": "0.2.0",
  "private": true,
  "description": "Snapcheck Core — design tokens, React components, and the spec sheet that shows them.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./theme.css": "./src/tokens/theme.css",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "scripts": {
