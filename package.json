{
  "name": "snapcheck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @snapcheck/core-ui dev",
    "storybook": "pnpm --filter @snapcheck/core-ui storybook",
    "build-storybook": "pnpm --filter @snapcheck/core-ui build-storybook",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1"
}
